# Security headers, sent with every page by Cloudflare Pages (Netlify reads this
# file too). The Content Security Policy for scripts and styles is a <meta> tag
# Astro writes into each page (see astro.config.mjs); frame-ancestors only works
# as a real header, so it's set here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Astro's built files have content hashes in their names, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
