---
import { site } from '../data/site';
import Photo from './ui/Photo.astro';
import BookButton from './ui/BookButton.astro';
import Icon from './ui/Icon.astro';
import { splitWords } from '../utils/text';
import { getPhoto } from '../utils/photos';

const { hero } = site;
const headline = splitWords(hero.headline);

// Only the slideshow photos that exist. With none, the first one shows its gray placeholder box.
const existing = hero.slides.filter((slide) => getPhoto(slide.file));
const slides = existing.length > 0 ? existing : hero.slides.slice(0, 1);
const isSlideshow = slides.length > 1;
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="theme-dark relative isolate flex min-h-svh items-end overflow-hidden"
  data-slideshow={isSlideshow ? '' : undefined}
  style={`--slide-duration: ${hero.slideSeconds}s`}
>
  <!-- Cover photos (cross-fading slideshow).
       `sizes`: on screens taller than 3:2 (phones, portrait tablets) the 3:2 photo
       is cropped to fill the height, so it's drawn about 1.5× the screen height
       wide — not the screen width. Without this, phones load a too-small file. -->
  <div class="absolute inset-0 -z-10 bg-ink">
    {
      slides.map((slide, i) => (
        <div
          class="hero-slide absolute inset-0"
          style={`--focus: ${slide.focus}`}
          data-slide
          data-active={i === 0 ? '' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
          hidden={i > 0}
        >
          <Photo
            file={slide.file}
            alt={slide.alt}
            placeholder={hero.placeholder}
            widths={[640, 960, 1280, 1600, 1920, 2048, 2400]}
            sizes="(max-aspect-ratio: 3/2) 150vh, 100vw"
            fill
            priority={i === 0}
            develop={false}
            rounded={false}
            placeholderAtTop
            style={`object-position: ${slide.focus}`}
          />
        </div>
      ))
    }
    <div class="hero-overlay absolute inset-0 z-10" aria-hidden="true"></div>
    <div class="hero-grain" aria-hidden="true"></div>
  </div>

  <div class="shell pt-28 pb-16 sm:pb-20 lg:pb-24">
    <div class="max-w-3xl">
      <p class="eyebrow hero-eyebrow hero-in max-sm:tracking-[0.2em] max-sm:before:hidden">{hero.eyebrow}</p>
      <!-- Each word surfaces out of a blur, one after another -->
      <h1
        id="hero-title"
        class="hero-title mt-6 text-[clamp(2.9rem,12.5vw,6.5rem)] leading-[0.98] text-cream"
        style="--delay: 150ms"
      >
        {
          headline.map((word, i) => (
            <>
              {i > 0 && ' '}
              <span class="hero-word" style={`--wi: ${i}`}>
                {word.map((piece) => (piece.em ? <em class="text-tan">{piece.text}</em> : piece.text))}
              </span>
            </>
          ))
        }
      </h1>
      <p class="hero-in mt-6 max-w-xl text-base text-cream/85 sm:text-lg" style="--delay: 750ms">
        {hero.tagline}
      </p>
      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:gap-4" style="--delay: 900ms">
        <a href={hero.primaryCta.href} class="btn btn-tan">
          {hero.primaryCta.label}
          <Icon name="arrow" class="btn-arrow size-4" />
        </a>
        <BookButton label={hero.bookCta} variant="outline" />
      </div>
    </div>
  </div>
</section>

<script>
  // Does nothing when there's only one photo (no data-slideshow attribute).
  import '../scripts/slideshow.ts';
</script>
