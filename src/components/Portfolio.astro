---
import { site, type Orientation } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import LightboxPhoto from './ui/LightboxPhoto.astro';

const { portfolio } = site;

const ratios: Record<Orientation, string> = { vertical: '4 / 5', horizontal: '3 / 2', square: '1 / 1' };
const categoryLabel = (value: string) => portfolio.filters.find((f) => f.value === value)?.label ?? value;

// Thumbnails: 1 column on phones, 2 on tablets, 3 on desktop.
const thumbSizes =
  '(min-width: 1200px) 368px, (min-width: 1024px) calc((100vw - 6.5rem) / 3), (min-width: 640px) calc((100vw - 5.25rem) / 2), calc(100vw - 2.5rem)';
const thumbWidths = [360, 540, 720, 1080];
---

<section id="portfolio" aria-labelledby="portfolio-title" class="section" data-gallery>
  <div class="shell">
    <div class="flex flex-col gap-8">
      <SectionHeading id="portfolio-title" eyebrow={portfolio.eyebrow} title={portfolio.title} intro={portfolio.intro} />

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter photos by category" data-reveal>
        {
          portfolio.filters.map((filter, i) => (
            <button
              type="button"
              class="min-h-11 rounded-full border border-line px-5 text-[0.8125rem] font-medium tracking-[0.12em] text-cream uppercase transition-[color,background-color,border-color,translate] duration-300 hover:not-aria-pressed:-translate-y-0.5 hover:not-aria-pressed:border-tan hover:not-aria-pressed:text-tan aria-pressed:border-tan aria-pressed:bg-tan aria-pressed:text-ink"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-filter={filter.value}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-gallery-status data-template={portfolio.statusTemplate}></p>

    <ul class="mt-10 columns-1 gap-4 sm:columns-2 sm:gap-5 lg:mt-14 lg:columns-3">
      {
        portfolio.items.map((item, i) => (
          <li
            class="mb-4 break-inside-avoid sm:mb-5"
            data-gallery-item
            data-category={item.category}
            data-reveal="wipe"
            style={`--reveal-delay: ${(i % 3) * 90}ms`}
          >
            <LightboxPhoto
              file={item.file}
              alt={item.alt}
              placeholder={`${categoryLabel(item.category)} photo ${String(i + 1).padStart(2, '0')} — ${item.orientation}`}
              ratio={ratios[item.orientation]}
              widths={thumbWidths}
              sizes={thumbSizes}
            >
              <span
                class="theme-dark pointer-events-none absolute inset-x-0 bottom-0 translate-y-3 bg-linear-to-t from-ink/80 to-transparent px-5 pt-12 pb-4 text-xs font-medium tracking-[0.2em] text-cream uppercase opacity-0 transition-[opacity,translate] duration-500 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
                aria-hidden="true"
              >
                {categoryLabel(item.category)}
              </span>
            </LightboxPhoto>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '../scripts/gallery.ts';
</script>
