---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';

const { process } = site;
---

<section id="how-it-works" aria-labelledby="process-title" class="section">
  <div class="shell">
    <SectionHeading id="process-title" eyebrow={process.eyebrow} title={process.title} />

    <div class="relative mt-12 lg:mt-16">
    <!-- Connecting line on desktop -->
    <span class="absolute top-7 right-[12%] left-7 hidden h-px bg-linear-to-r from-tan/60 via-line to-line lg:block" aria-hidden="true"></span>
    <ol class="relative grid gap-10 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4">
      {
        process.steps.map((step, i) => (
          <li class="relative flex gap-5 sm:flex-col sm:gap-6" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <span
              class="relative flex size-14 shrink-0 items-center justify-center rounded-full border border-tan/60 bg-ink font-serif text-xl text-tan italic"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-[1.75rem] text-cream">{step.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>
