---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';

const { testimonials } = site;
---

<section id="testimonials" aria-labelledby="testimonials-title" class="section border-t border-line/60 bg-surface/40">
  <div class="shell">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading id="testimonials-title" eyebrow={testimonials.eyebrow} title={testimonials.title} />
      <div class="flex flex-col items-start gap-1 lg:items-end" data-reveal>
        <p class="text-[0.9375rem] text-cream">{testimonials.summary}</p>
        <a href={testimonials.summaryLink.href} class="arrow-link" target="_blank" rel="noopener noreferrer">
          {testimonials.summaryLink.label}<span class="sr-only"> on Facebook (opens in new tab)</span>
          <Icon name="arrow" class="arrow size-4" />
        </a>
      </div>
    </div>

    <!-- Masonry: reviews of different lengths pack neatly into 2 columns -->
    <ul class="mt-10 gap-5 md:columns-2 lg:mt-14">
      {
        testimonials.items.map((item, i) => (
          <li class="mb-5 break-inside-avoid" data-reveal style={`--reveal-delay: ${(i % 2) * 100}ms`}>
            <figure class="card card-hover flex w-full flex-col p-7 sm:p-8">
              <Icon name="quote" class="quote-icon size-7 text-tan/80" strokeWidth={1.25} />
              <blockquote class="mt-5 font-serif text-[1.35rem] leading-snug text-cream italic">
                <p>{item.quote}</p>
              </blockquote>
              <figcaption class="mt-7 flex items-center gap-3 border-t border-line pt-5">
                <span class="icon-badge flex size-9 shrink-0 items-center justify-center rounded-full border border-line text-tan" aria-hidden="true">
                  <Icon name="facebook" class="size-4" />
                </span>
                <span>
                  <span class="block font-medium text-cream">{item.name}</span>
                  <span class="mt-0.5 block text-xs tracking-[0.18em] text-tan uppercase">{item.source}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
