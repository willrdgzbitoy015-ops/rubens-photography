---
import { splitEmphasis } from '../../utils/text';

/**
 * Gold eyebrow label + large serif headline. Wrap words in *asterisks*
 * to show them in tan italics, e.g. "What I *photograph*".
 */
interface Props {
  /** id of the heading — the section uses it in aria-labelledby */
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { id, eyebrow, title, intro, align = 'left', class: className } = Astro.props;
const parts = splitEmphasis(title);
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]} data-reveal>
  <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>
  <h2 id={id} class="mt-5 text-[2.6rem] sm:text-5xl lg:text-[3.75rem]">
    {parts.map((part) => (part.em ? <em class="text-tan">{part.text}</em> : part.text))}
  </h2>
  {intro && <p class="mt-5 text-base text-muted sm:text-lg">{intro}</p>}
  <slot />
</div>
