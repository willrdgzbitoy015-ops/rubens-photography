---
import { splitWords } from '../../utils/text';

/**
 * Large serif section headline. Wrap words in *asterisks*
 * to show them in tan italics, e.g. "What I *photograph*".
 * When the heading scrolls into view, each word rises out of its own line
 * (styles: "Headings: each word rises" in global.css).
 */
interface Props {
  /** id of the heading — the section uses it in aria-labelledby */
  id: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { id, title, intro, align = 'left', class: className } = Astro.props;
const words = splitWords(title);
---

<div class:list={['section-heading max-w-2xl', align === 'center' && 'mx-auto text-center', className]} data-reveal>
  <h2 id={id} class="text-[2.6rem] sm:text-5xl lg:text-[3.75rem]">
    {
      words.map((word, i) => (
        <>
          {i > 0 && ' '}
          <span class="split-word">
            <span class="split-word-inner" style={`--wi: ${i}`}>
              {word.map((piece) => (piece.em ? <em class="text-tan">{piece.text}</em> : piece.text))}
            </span>
          </span>
        </>
      ))
    }
  </h2>
  {intro && <p class="mt-5 text-base text-muted sm:text-lg">{intro}</p>}
  <slot />
</div>
