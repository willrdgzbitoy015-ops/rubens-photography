---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import { getBrandImage } from '../../utils/photos';
import { splitEmphasis } from '../../utils/text';

/**
 * nav:    "R" mark on a cream badge + the text wordmark
 * footer: the full logo (with Baybayin + tagline) on a cream card
 * Falls back to the text wordmark if the logo files are missing.
 */
interface Props {
  variant?: 'nav' | 'footer';
  class?: string;
}

const { variant = 'nav', class: className } = Astro.props;
const mark = getBrandImage(site.logo.mark);
const full = getBrandImage(site.logo.full);
const parts = splitEmphasis(site.wordmark);
---

{
  variant === 'footer' && full ? (
    <span class:list={['inline-block rounded-2xl bg-cream p-4 shadow-[0_20px_50px_-30px_rgb(0_0_0/0.8)]', className]}>
      <Image src={full} alt={site.logo.fullAlt} width={150} densities={[1, 2]} class="block h-auto w-[150px]" />
    </span>
  ) : (
    <span class:list={['flex items-center gap-3', className]}>
      {mark && (
        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-cream sm:size-11" aria-hidden="true">
          <Image src={mark} alt="" height={30} densities={[1, 2]} loading="eager" class="block h-[26px] w-auto sm:h-[30px]" />
        </span>
      )}
      <span class="font-serif text-[1.45rem] leading-none font-semibold tracking-tight whitespace-nowrap sm:text-[1.6rem]">
        {parts.map((part) => (part.em ? <em class="font-medium text-gold">{part.text}</em> : part.text))}
      </span>
    </span>
  )
}
