---
import { site } from '../../data/site';
import { getBrandImage } from '../../utils/photos';
import { splitEmphasis } from '../../utils/text';
import LogoArt from './LogoArt.astro';

/**
 * nav:    the "R" mark + the text wordmark
 * footer: the full logo (with Baybayin + tagline)
 * Both have no background and take the theme's colors (see LogoArt).
 * Falls back to the text wordmark if the logo files are missing.
 */
interface Props {
  variant?: 'nav' | 'footer';
  class?: string;
}

const { variant = 'nav', class: className } = Astro.props;
const hasFull = Boolean(getBrandImage(site.logo.full));
const parts = splitEmphasis(site.wordmark);
---

{
  variant === 'footer' && hasFull ? (
    <LogoArt file={site.logo.full} maxWidth={176} label={site.logo.fullAlt} class:list={['brand-full w-40 sm:w-44', className]} />
  ) : (
    <span class:list={['flex items-center gap-2.5', className]}>
      <LogoArt file={site.logo.mark} maxWidth={48} class="brand-mark h-9 sm:h-[2.625rem]" />
      <span class="font-serif text-[1.45rem] leading-none font-semibold tracking-tight whitespace-nowrap sm:text-[1.6rem]">
        {parts.map((part) => (part.em ? <em class="font-medium text-tan">{part.text}</em> : part.text))}
      </span>
    </span>
  )
}
