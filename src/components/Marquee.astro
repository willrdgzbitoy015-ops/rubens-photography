---
import { site } from '../data/site';
import Icon from './ui/Icon.astro';

// The list is shown twice so the loop is seamless; the copy is hidden from screen readers.
const copies = [false, true];
---

<div class="marquee relative overflow-hidden border-y border-line bg-surface/60 py-5 sm:py-6">
  <div class="marquee-track">
    {
      copies.map((isCopy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={isCopy ? 'true' : undefined} aria-label={isCopy ? undefined : 'What I photograph'}>
          {site.marquee.map((item) => (
            <li class="flex items-center">
              <span class="px-6 font-serif text-[1.65rem] leading-none whitespace-nowrap text-cream italic sm:px-8 sm:text-3xl">
                {item}
              </span>
              <svg viewBox="0 0 12 12" class="size-2.5 shrink-0 text-tan" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M6 0c.5 3.3 2.2 5 6 6-3.8 1-5.5 2.7-6 6-.5-3.3-2.2-5-6-6 3.8-1 5.5-2.7 6-6z"
                />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <!-- Pause button (moving content should be pausable) -->
  <button
    type="button"
    class="marquee-toggle absolute inset-y-0 right-0 flex w-14 items-center justify-end bg-linear-to-l from-ink from-45% to-transparent pr-3 text-muted transition-colors hover:text-tan"
    aria-pressed="false"
    data-marquee-toggle
  >
    <span class="sr-only">Pause scrolling text</span>
    <Icon name="pause" class="size-4" />
  </button>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  const marquee = button?.closest<HTMLElement>('.marquee');
  if (button && marquee) {
    const pauseIcon = button.querySelector('svg')!.innerHTML;
    const playIcon = '<path d="M6 4l14 8-14 8z"/>';
    button.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      marquee.toggleAttribute('data-paused', paused);
      button.querySelector('svg')!.innerHTML = paused ? playIcon : pauseIcon;
    });
  }
</script>
