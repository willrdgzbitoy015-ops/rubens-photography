---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import DraftNote from './ui/DraftNote.astro';
import Icon from './ui/Icon.astro';

const { faq } = site;
---

<section id="faq" aria-labelledby="faq-title" class="section">
  <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHeading id="faq-title" eyebrow={faq.eyebrow} title={faq.title} intro={faq.intro}>
        {faq.answersArePlaceholder && <DraftNote class="mt-6" />}
      </SectionHeading>
    </div>

    <div class="border-t border-line lg:col-span-7" data-reveal style="--reveal-delay: 100ms">
      {
        faq.items.map((item) => (
          <details class="faq-item group border-b border-line">
            <summary class="flex min-h-11 items-center justify-between gap-6 py-6 font-serif text-[1.5rem] leading-snug text-cream transition-colors hover:text-gold sm:text-[1.65rem]">
              {item.q}
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-line text-gold transition-colors group-open:border-gold/60">
                <Icon name="plus" class="faq-icon size-4" />
              </span>
            </summary>
            <p class="max-w-xl pb-7 text-[0.9375rem] leading-relaxed text-muted sm:text-base">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
