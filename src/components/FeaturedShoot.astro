---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import LightboxPhoto from './ui/LightboxPhoto.astro';
import ArrowLink from './ui/ArrowLink.astro';

const { featured } = site;
const [main, ...more] = featured.photos;
---

<section id="featured" aria-labelledby="featured-title" class="section" data-gallery>
  <div class="shell grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7" data-reveal>
      <!-- Main photo -->
      {
        main && (
          <div class="relative aspect-[3/2] lg:aspect-[4/3]" data-gallery-item>
            <LightboxPhoto
              file={main.file}
              alt={main.alt}
              placeholder={main.placeholder}
              widths={[480, 720, 960, 1280, 1600]}
              sizes="(min-width: 1200px) 640px, (min-width: 1024px) 54vw, calc(100vw - 2.5rem)"
              fill
            />
          </div>
        )
      }

      <!-- Supporting photos -->
      {
        more.length > 0 && (
          <ul class="mt-2 grid grid-cols-5 gap-2 sm:mt-3 sm:gap-3" aria-label="More photos from this shoot">
            {more.map((photo) => (
              <li class="lift relative aspect-square" data-gallery-item>
                <LightboxPhoto
                  file={photo.file}
                  alt={photo.alt}
                  placeholder={photo.placeholder}
                  widths={[120, 240, 360]}
                  sizes="(min-width: 1200px) 118px, (min-width: 1024px) 10vw, 18vw"
                  fill
                  compact
                  radius="rounded-lg"
                />
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="lg:col-span-5">
      <SectionHeading id="featured-title" title={featured.title} />
      <div data-reveal style="--reveal-delay: 120ms">
        <div class="mt-8">
          <ArrowLink href={featured.link.href} label={featured.link.label} />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/gallery.ts';
</script>
