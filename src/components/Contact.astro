---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import BookButton from './ui/BookButton.astro';
import { isPlaceholder } from '../utils/text';

const { contactSection: c, contact, social } = site;

// Social links in the first card; any still left as a [placeholder] is hidden.
const socialLinks = [
  { label: c.facebookLabel, href: social.facebook, srLabel: `${site.brand} on Facebook` },
  { label: c.personalFacebookLabel, href: social.facebookPersonal, srLabel: `${site.photographerFullName} on Facebook` },
  { label: c.instagramLabel, href: social.instagram, srLabel: `${site.photographerFullName} on Instagram` },
].filter((link) => !isPlaceholder(link.href));
---

<section id="contact" aria-labelledby="contact-title" class="section relative isolate overflow-hidden">
  <!-- Soft tan glow behind the call to action -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_55%_at_50%_45%,color-mix(in_srgb,var(--color-tan)_10%,transparent),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="shell">
    <SectionHeading id="contact-title" eyebrow={c.eyebrow} title={c.title} intro={c.intro} align="center" />

    <div class="mt-10 flex flex-col items-center gap-4 text-center" data-reveal style="--reveal-delay: 100ms">
      <BookButton
        label={c.primaryCta}
        icon
        class="min-h-16 w-full px-5 text-[0.875rem] tracking-[0.06em] sm:w-auto sm:px-10 sm:text-[0.9375rem] sm:tracking-[0.14em]"
      />
      <p class="text-sm text-muted">{c.replyNote}</p>
    </div>

    <!-- Other ways to reach Ruben -->
    <ul class="mx-auto mt-14 grid max-w-4xl gap-4 sm:grid-cols-3" data-reveal style="--reveal-delay: 180ms">
      <li class="card flex flex-col items-center gap-3 p-6 text-center">
        <span class="icon-badge flex size-12 items-center justify-center rounded-full border border-line text-tan">
          <Icon name="facebook" class="size-5" />
        </span>
        <span class="font-medium text-cream">{c.socialTitle}</span>
        <span class="flex flex-wrap justify-center gap-2">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                aria-label={`${link.label}: ${link.srLabel} (opens in new tab)`}
                class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-line px-4 text-sm text-cream transition-colors hover:border-tan hover:text-tan"
              >
                {link.label}
              </a>
            ))
          }
        </span>
      </li>

      <li class="card flex flex-col items-center gap-3 p-6 text-center">
        <span class="icon-badge flex size-12 items-center justify-center rounded-full border border-line text-tan">
          <Icon name="phone" class="size-5" />
        </span>
        <span class="font-medium text-cream">{c.phoneLabel}</span>
        <span class="flex gap-2">
          <a
            href={contact.phoneHref}
            class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-line px-4 text-sm text-cream transition-colors hover:border-tan hover:text-tan"
          >
            {c.callLabel}<span class="sr-only"> {contact.phoneDisplay}</span>
          </a>
          <a
            href={contact.smsHref}
            class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-line px-4 text-sm text-cream transition-colors hover:border-tan hover:text-tan"
          >
            {c.textLabel}<span class="sr-only"> {contact.phoneDisplay}</span>
          </a>
        </span>
      </li>

      <li class="flex">
        <a href={`mailto:${contact.email}`} class="card card-hover flex w-full flex-col items-center gap-3 p-6 text-center">
          <span class="icon-badge flex size-12 items-center justify-center rounded-full border border-line text-tan">
            <Icon name="mail" class="size-5" />
          </span>
          <span class="font-medium text-cream">{c.emailLabel}</span>
          <span class="text-sm break-all text-muted">{contact.email}</span>
        </a>
      </li>
    </ul>
  </div>
</section>
