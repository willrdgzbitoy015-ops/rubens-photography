---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import BookButton from './ui/BookButton.astro';
import { isPlaceholder } from '../utils/text';

const { contactSection: c, contact, social } = site;

// Social links in the first card; any still left as a [placeholder] is hidden.
const socialLinks = [
  { label: c.facebookLabel, href: social.facebook, srLabel: `${site.brand} on Facebook` },
  { label: c.personalFacebookLabel, href: social.facebookPersonal, srLabel: `${site.photographerFullName} on Facebook` },
  { label: c.instagramLabel, href: social.instagram, srLabel: `${site.photographerFullName} on Instagram` },
].filter((link) => !isPlaceholder(link.href));

// Phones: icon + text on one line, buttons underneath. Wider: all three in a row.
const rowClass =
  'contact-row grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-3 border-b border-line py-5 sm:grid-cols-[auto_1fr_auto] sm:gap-x-6 sm:py-6';
const badgeClass = 'icon-badge flex size-11 items-center justify-center rounded-full border border-line text-tan';
const actionsClass = 'col-start-2 flex flex-wrap gap-2 sm:col-start-3 sm:justify-end';
---

<section id="contact" aria-labelledby="contact-title" class="section relative isolate overflow-hidden">
  <!-- Soft tan glow behind the call to action -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_55%_at_50%_45%,color-mix(in_srgb,var(--color-tan)_10%,transparent),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="shell">
    <SectionHeading id="contact-title" title={c.title} intro={c.intro} align="center" />

    <div class="mt-10 flex flex-col items-center gap-4 text-center" data-reveal style="--reveal-delay: 100ms">
      <BookButton
        label={c.primaryCta}
        icon
        class="min-h-16 w-full px-5 text-[0.875rem] tracking-[0.06em] sm:w-auto sm:px-10 sm:text-[0.9375rem] sm:tracking-[0.14em]"
      />
      <p class="text-sm text-muted">{c.replyNote}</p>
    </div>

    <!-- Other ways to reach Ruben: one row each — icon, what it is, buttons -->
    <ul class="mx-auto mt-14 max-w-3xl border-t border-line" data-reveal style="--reveal-delay: 180ms">
      <li class={rowClass}>
        <span class={badgeClass} aria-hidden="true"><Icon name="facebook" class="size-5" /></span>
        <p class="font-medium text-cream">{c.socialTitle}</p>
        <div class={actionsClass}>
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.label}: ${link.srLabel} (opens in new tab)`}
                class="pill-link"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </li>

      <li class={rowClass}>
        <span class={badgeClass} aria-hidden="true"><Icon name="phone" class="size-5" /></span>
        <p>
          <span class="block font-medium text-cream">{c.phoneLabel}</span>
          <span class="block text-[0.9375rem] text-muted tabular-nums">{contact.phoneDisplay}</span>
        </p>
        <div class={actionsClass}>
          <a href={contact.phoneHref} class="pill-link">
            {c.callLabel}<span class="sr-only"> {contact.phoneDisplay}</span>
          </a>
          <a href={contact.smsHref} class="pill-link">
            {c.textLabel}<span class="sr-only"> {contact.phoneDisplay}</span>
          </a>
        </div>
      </li>

      <li class={rowClass}>
        <span class={badgeClass} aria-hidden="true"><Icon name="mail" class="size-5" /></span>
        <p class="min-w-0">
          <span class="block font-medium text-cream">{c.emailLabel}</span>
          <span class="block text-[0.9375rem] break-all text-muted">{contact.email}</span>
        </p>
        <div class={actionsClass}>
          <a href={`mailto:${contact.email}`} class="pill-link">{c.emailAction}</a>
        </div>
      </li>
    </ul>
  </div>
</section>
