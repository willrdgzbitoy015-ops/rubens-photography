---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';

const { services } = site;
---

<section id="services" aria-labelledby="services-title" class="section border-t border-line/60 bg-surface/40">
  <div class="shell">
    <SectionHeading id="services-title" eyebrow={services.eyebrow} title={services.title} intro={services.intro} />

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-16 lg:grid-cols-4">
      {
        services.items.map((item, i) => (
          <li class="card card-hover flex flex-col p-7 sm:p-8" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <span class="font-serif text-4xl text-gold italic" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-8 text-[1.85rem] text-cream sm:mt-10">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
