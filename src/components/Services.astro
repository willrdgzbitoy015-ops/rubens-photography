---
import { site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import Photo from './ui/Photo.astro';
import ArrowLink from './ui/ArrowLink.astro';

const { services } = site;

// 1 column on phones, 2 on tablets, 4 on desktop (the shell is 75rem wide).
const cardSizes = '(min-width: 1200px) 269px, (min-width: 1024px) calc((100vw - 6.5rem) / 4), (min-width: 640px) calc((100vw - 5.25rem) / 2), calc(100vw - 2.5rem)';
---

<section id="services" aria-labelledby="services-title" class="section border-t border-line/60 bg-surface/40">
  <div class="shell">
    <SectionHeading id="services-title" title={services.title} intro={services.intro} />

    <!-- Cards in a row share one height; each card's link sits at its bottom,
         so the links line up across the row. -->
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        services.items.map((item, i) => (
          <li class="card card-hover service-card group flex flex-col" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="relative aspect-[4/3] overflow-hidden sm:aspect-[4/5]">
              <Photo
                file={item.file}
                alt={item.alt}
                placeholder={item.title}
                ratio="4 / 5"
                widths={[360, 540, 720, 1080]}
                sizes={cardSizes}
                fill
                rounded={false}
                class="zoom-img"
                style={`object-position: ${item.focus}`}
              />
            </div>
            <div class="flex flex-1 flex-col px-6 pt-6 pb-3 sm:px-7 sm:pt-7 sm:pb-4">
              <h3 class="text-[1.6rem] leading-tight text-cream">{item.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.text}</p>
              <ArrowLink href="#portfolio" label={item.cta} class="mt-auto self-start pt-6" data-show-category={item.category} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // "See wedding photos" scrolls down to the Portfolio with that category already selected.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-show-category]')) {
    link.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>(`#portfolio [data-filter="${link.dataset.showCategory}"]`)?.click();
    });
  }
</script>
